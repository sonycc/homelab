# Apex domain. The wiki is served at wiki.<domain> and $wgServer is built from
# this, so it must match DOMAIN in the other stack .env files.
DOMAIN=your-domain.tld

TZ=Europe/Oslo

MW_SITENAME=Homebrew Wiki

# Named in the footer as holder of the default CC BY-NC-ND 4.0 licence.
MW_LICENSE_HOLDER=Your Name

# --- Database ---
# The role and database must exist before the first deploy; see DEPLOYMENT.md.
MW_DB_NAME=mediawiki
MW_DB_USER=mediawiki
MW_DB_PASSWORD=change_me_strong_password

# Postgres schema inside that database. MediaWiki's own default; changing it after
# the first install points the wiki at an empty schema.
MW_DB_SCHEMA=mediawiki

# --- Secrets ---
# MediaWiki's own, unrelated to any login. Generate with: 'openssl rand -hex 32' to make 64 character hex string.
MW_SECRET_KEY=change_me_64_hex_characters

# First admin account, created on first boot only. Later changes here do nothing:
#   docker compose exec mediawiki php maintenance/run.php changePassword \
#     --user <name> --password <new>
# At least 12 characters: the installer requires 10, and the wiki requires 12.
MW_ADMIN_USER=admin
MW_ADMIN_PASSWORD=change_me_strong_password

# --- images/ backups ---
# The database is covered by the postgres stack's pg_dumpall. This covers uploads.
# Point at storage that outlives this VM (AUDIT M16).
BACKUP_HOST_DIR=./backup

# Archives are written only when images/ changed, so this keeps the last N
# distinct states rather than N copies of the same files.
IMAGES_KEEP=10
IMAGES_CHECK_INTERVAL=3600

# How stale the newest successful check may get before mediawiki-tasks reports
# unhealthy. Must exceed IMAGES_CHECK_INTERVAL.
BACKUP_MAX_AGE_SECONDS=7200

# Jobs drained per minute. Raise after a bulk import or a template edit that
# touches many pages.
JOB_BATCH=50

# Signup question. Only players should know the answer, which is why it lives here
# and not in the public repo. Answers are separated by |, and are not case-sensitive.
MW_CAPTCHA_QUESTION=A question only your players can answer?
MW_CAPTCHA_ANSWERS=answer|another answer| yet another answer

# Optional. A Discord webhook that gets a message for every new account, with a
# link to give it a role. Its own channel, separate from DISCORD_WEBHOOK_URL below.
MW_SIGNUP_WEBHOOK_URL=

# Optional, same webhook as stacks/wud/.env. Without it a failed images archive
# is only visible in `docker logs mediawiki-tasks`.
DISCORD_WEBHOOK_URL=
