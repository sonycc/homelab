# Public hostname, e.g. cloud.your-domain.tld.
# Becomes the trusted domain and the base of every generated link.
NC_HOST=cloud.your-domain.tld

TZ=Europe/Oslo

# --- Database ---
# Created by the postgres_tenant role; copy the password from
# infra/ansible/.secrets/nextcloud_db_password after its first run.
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=change_me_strong_password

# First admin account, created on first boot only. Later changes here do nothing:
#   docker compose exec -u www-data nextcloud php occ user:resetpassword <name>
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=change_me_strong_password
