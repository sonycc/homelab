# Container timezone — affects backup filenames and the restart window.
TZ=Europe/Oslo

# --- Server ---
# Cosmetic: the server is not listed in the browser, so this only shows in-game.
SERVER_NAME=Homelab Valheim

# Names the world directory under /config/worlds_local. Changing it starts a new
# world rather than renaming the old one.
WORLD_NAME=change_me

# Minimum 5 characters, and the server refuses to start if it appears in SERVER_NAME.
SERVER_PASS=change_me

# Host address the game ports bind to. 127.0.0.1 means the playit tunnel is the only
# way in. Set it to the LAN address to let players on the network connect direct.
VALHEIM_BIND=127.0.0.1

# --- playit.gg ---
# Agent secret, one per agent. Generate at:
#   https://playit.gg/account/setup/wizard/new-account/docker/docker-name
# Then add a UDP tunnel in the playit dashboard pointing at local 127.0.0.1:2456.
PLAYIT_SECRET_KEY=

# --- Mods ---
# Thunderstore packages as Namespace-Name-Version, space separated.
# Players need the same versions. Changes apply on the next deploy.
VALHEIM_MODS=Advize-PlantEverything-1.21.3 Advize-StumpsRegrow-1.1.0

# --- Resources ---
# 2g runs a fresh world, 4g an explored one.
VALHEIM_MEM_LIMIT=4g
VALHEIM_CPUS=2.0

# --- Schedules ---
# false makes 05:00 unconditional, disconnecting anyone still online. The stop is
# graceful either way, so nobody loses progress.
RESTART_CRON=0 5 * * *
RESTART_IF_IDLE=true

# Backups are hourly. Pruned by whichever bound is hit first.
BACKUPS_MAX_AGE=14
BACKUPS_MAX_COUNT=48

# Host directory the archives land in, relative to the compose file. Bind-mounted so
# the nightly pull can read them without root on this machine.
VALHEIM_BACKUP_DIR=./backups
