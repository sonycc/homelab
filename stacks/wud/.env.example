# Apex domain the homelab is served on. WUD is served at wud.<domain>, and it reaches
# GitLab's OIDC discovery document at gitlab.<domain>.
DOMAIN=your-domain.com

# How often WUD scans for updates (cron). Default: every 6 hours.
WUD_CRON=0 */6 * * *

# Watch all containers unless labeled wud.watch=false. Set false to opt-in per container.
WUD_WATCHBYDEFAULT=true

# Log level: debug | info | warn | error
WUD_LOG_LEVEL=info

# --- GitLab OIDC ---
# From GitLab > User Settings (or Admin) > Applications.
# Callback URL to register there: https://wud.<domain>/auth/oidc/gitlab/cb
# Scopes: openid, profile, email  |  Confidential: yes
# All three are required: WUD hardcodes `scope: openid email profile` and cannot be
# configured to request fewer, even though USERNAMECLAIM is preferred_username.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Discord notifications ---
# Discord > Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Which updates to notify about:
#   all         every update (default)
#   minor       minor and major only, ignore patch bumps
#   major-only  only major version bumps
DISCORD_THRESHOLD=all
