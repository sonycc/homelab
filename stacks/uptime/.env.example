# Container timezone — affects timestamps on the monitor timeline.
TZ=Europe/Oslo

# Port Uptime Kuma is reached on over the LAN. Not behind NPM or the tunnel: a
# monitor must not depend on the proxy it watches.
UPTIME_PORT=3001

# --- AutoKuma ---
# Uptime Kuma admin account AutoKuma logs in as to sync the monitor files. Create
# it through the UI first — first-run onboarding cannot be automated, and there is
# no API to create it either.
#
# Worth its own account rather than reusing yours: it holds full admin rights over
# the monitors, and a separate one is revocable without locking you out.
KUMA_USER=autokuma
KUMA_PASSWORD=change_me_strong_password
