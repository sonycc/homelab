# Runner authentication token from the GitLab UI:
#   Admin Area → CI/CD → Runners → "New instance runner" → copy the glrt-... token
#
# Shown once, and per-instance: the token from the old host does not survive the
# migration, so this needs reissuing against the GitLab on vm-core.
GITLAB_RUNNER_TOKEN=glrt-xxxxxxxxxxxxxxxxxxxx

# How this host reaches GitLab. It is on a different VM than GitLab, so the old
# http://gitlab:80 (Docker DNS on a shared network) does not resolve.
#
# The public URL works with no extra plumbing but hairpins out through Cloudflare
# and back, so a WAN outage takes CI down with it. The alternative is pinning the
# public hostname to vm-core's vmbr1 address via extra_hosts, which keeps TLS valid
# against the wildcard cert but needs NPM to publish 443 there first.
GITLAB_INTERNAL_URL=https://gitlab.your-domain.com
