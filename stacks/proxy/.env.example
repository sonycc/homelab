# Apex domain the homelab is served on. Used to build the NPM network aliases
# (gitlab.<domain>, registry.<domain>) that give internal clients the same HTTPS
# URL as external ones. Required — compose refuses to start without it.
DOMAIN=your-domain.com

NGINX_DB_USER=nginx
NGINX_DB_PASSWORD=strong_password_here
NGINX_DB_NAME=nginx

CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# --- fail2ban ---
# Bans are applied as Cloudflare IP Access Rules, not iptables — nothing local
# can see a real client address behind the tunnel. See
# fail2ban/action.d/cloudflare-api.conf.
#
# Create the token at: Cloudflare dashboard → Manage Account → API Tokens → Create Token
#   Permissions: Account → Firewall Access Rules → Edit
#   Resources:   Include → your account
#
# The documented permission for the IP Access Rules endpoint is "Account Firewall
# Access Rules Write", which is account-scoped — there is no zone-scoped
# equivalent, so this token cannot be restricted to a single zone. It still
# cannot read DNS, touch the tunnel, or see traffic; it can only add and remove
# IP block rules.
#
# This is a *different* token from CLOUDFLARE_TUNNEL_TOKEN above.
CLOUDFLARE_API_TOKEN=your_firewall_api_token_here

# Overview → API section, bottom right of any zone's dashboard page (the account
# id is shown alongside the zone id).
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Must stay longer than the jails' bantime.maxtime (7d) or ban escalation for
# repeat offenders resets.
F2B_DB_PURGE_AGE=30d
F2B_LOG_LEVEL=INFO
