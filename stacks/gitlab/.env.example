# Apex domain the homelab is served on. GitLab is served at gitlab.<domain> and its
# container registry at registry.<domain>; both must match the NPM proxy hosts and the
# Cloudflare tunnel hostnames. Required — compose refuses to start without it.
DOMAIN=your-domain.com

GITLAB_SSH_PORT=2222
GITLAB_HTTP_PORT=8080
GITLAB_REGISTRY_PORT=5050

GITLAB_DB_NAME=gitlab
GITLAB_DB_USER=gitlab
GITLAB_DB_PASSWORD=change_me_strong_password

# Runner authentication token from GitLab UI:
# Admin Area → CI/CD → Runners → "New instance runner" → copy glrt-... token (shown once)
GITLAB_RUNNER_TOKEN=glrt-xxxxxxxxxxxxxxxxxxxx

# Internal URL the runner uses to reach GitLab (defaults to http://gitlab:80 if unset)
GITLAB_INTERNAL_URL=http://gitlab:80
