# Apex domain the homelab is served on. GitLab is served at gitlab.<domain> and its
# container registry at registry.<domain>; both must match the NPM proxy hosts and the
# Cloudflare tunnel hostnames. Required — compose refuses to start without it.
DOMAIN=your-domain.com

GITLAB_SSH_PORT=2222
GITLAB_HTTP_PORT=8080
GITLAB_REGISTRY_PORT=5050

# Host address the HTTP and registry ports bind to. Loopback by default: both are
# reachable through NPM, and a host binding only creates a path that never passes
# Cloudflare and so cannot be edge-banned (AUDIT M9). Set to 0.0.0.0 only if
# something genuinely needs to reach them without going through the proxy.
#
# Does not apply to GITLAB_SSH_PORT — SSH has no route through the tunnel and is
# deliberately left on all interfaces.
GITLAB_BIND=127.0.0.1

GITLAB_DB_NAME=gitlab
GITLAB_DB_USER=gitlab
GITLAB_DB_PASSWORD=change_me_strong_password
