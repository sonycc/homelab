# Apex domain the homelab is served on. HA is served at home.<domain> — this must
# match the NPM proxy host and the Cloudflare tunnel hostname.
DOMAIN=your-domain.com

# Container timezone — affects timestamps, sun/dawn triggers and time-based automations.
TZ=Europe/Oslo

# Localhost-only port for the HA UI. Public access goes via NPM + Cloudflare.
HA_PORT=8123

# --- Recorder database (shared postgres stack) ---
# Create the role and database before first start: see create-db-user.md
# Comment out the `recorder:` block in config/configuration.yaml to use SQLite instead.
HA_DB_NAME=homeassistant
HA_DB_USER=homeassistant
HA_DB_PASSWORD=change_me_strong_password
