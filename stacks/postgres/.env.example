# Superuser role for the instance — pg_dumpall runs as this role and needs
# superuser to dump every database plus the role definitions.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# Database created on first start. Does not scope the backup; pg_dumpall is
# instance-wide.
POSTGRES_DB=default_db

# Container timezone — affects backup filenames and when the cron schedules below
# actually fire.
TZ=Europe/Oslo

# --- Backups ---
# Host directory the archives are written to; inside the container it is always
# /backups. Point this at storage that outlives the Docker VM, ideally somewhere
# backed up off-box.
BACKUP_HOST_DIR=./backup

# How stale the newest successful backup may get before the container reports
# itself unhealthy. 7200 (2h) suits the hourly schedule below; raise to at least
# 90000 (25h) if BACKUP_HOURLY_KEEP=0 and daily becomes the fastest cycle.
BACKUP_MAX_AGE_SECONDS=7200

BACKUP_HOURLY_KEEP=5
BACKUP_HOURLY_SCHEDULE="0 * * * *"
BACKUP_DAILY_KEEP=7
BACKUP_DAILY_SCHEDULE="0 0 * * *"
BACKUP_WEEKLY_KEEP=4
BACKUP_WEEKLY_SCHEDULE="0 0 * * 1"
BACKUP_MONTHLY_KEEP=6
BACKUP_MONTHLY_SCHEDULE="0 0 1 * *"
