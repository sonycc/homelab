# Copy to vps-nawth.yml (gitignored) and fill in. One of these per instance in
# vps.tf's for_each, and the filename must match the hostname the module builds.

# The user's public key(s). Ask for the .pub, never a private key, and never reuse
# ~/.ssh/homelab_infra.pub — that one opens every VM here.
file_share_keys:
  - "ssh-ed25519 AAAA... user@theirmachine"

# Only needed when this host overrides data_path on the module. The defaults in
# vps.yml and modules/vps/variables.tf are the same path.
# file_share_root: /srv/data

# Optional; see the vars block in vps.yml.
# file_share_user: share
# file_share_mode: rw
# file_share_no_delete: true
